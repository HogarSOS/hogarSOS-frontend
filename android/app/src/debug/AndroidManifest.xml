<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Solo en debug: permite tráfico HTTP sin cifrar hacia
         http://localhost:3000 durante el desarrollo (ver
         adb reverse en la documentación del proyecto). La release NO
         lleva esto — Play Console lo marca como advertencia de
         seguridad, y en producción todo va por HTTPS de todas formas. -->
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
    </application>
</manifest>
